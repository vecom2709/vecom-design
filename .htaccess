# Eigene Fehlerseite statt der Standardmeldung des Servers
ErrorDocument 404 /404.html

# Immer über https ausliefern
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Empfehlungslinks kurz halten: /e/ANNA3CU fuehrt in den Konfigurator.
# Kurz genug, um ihn am Telefon durchzugeben oder auf eine Karte zu drucken —
# darum geht es bei einer Empfehlung.
RewriteRule ^e/([A-Za-z0-9]{5,16})/?$ bedarf.php?e=$1 [L,QSA]

# /pakete.html gibt es nicht mehr.
#
# Dort standen Starter 499, Business 899 und Premium 1.499 — drei Pakete, die
# es seit dem 12.09.2026 nicht mehr gibt. Die Datei ist aus dem Repository
# genommen, aber der Deploy spiegelt nur und loescht nichts: Die alte Kopie
# liegt weiter auf dem Webspace. Diese Regel ist das, was sie unerreichbar
# macht — dieselbe Ueberlegung wie bei den .md-Dateien weiter unten.
#
# 301 und nicht 404, weil die Adresse in alten Angeboten und E-Mails steht.
# Wer sie oeffnet, soll dort landen, wo die Preise heute stehen, und nicht auf
# einer Fehlerseite. Das abschliessende "?" wirft die alte Abfrage weg, damit
# nicht ?lang=de an der italienischen Seite haengen bleibt.
RewriteCond %{QUERY_STRING} (^|&)lang=de(&|$)
RewriteRule ^pakete\.html$ /de/preise.html? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^pakete\.html$ /en/pricing.html? [R=301,L]
RewriteRule ^pakete\.html$ /prezzi.html? [R=301,L]

# Die Zähldatei ist nicht für Besucher bestimmt
<Files "besuche.csv">
  Require all denied
</Files>
<Files "config.local.php">
  Require all denied
</Files>
# Arbeitsnotizen gehoeren nicht auf die Kundendomain. PROJEKT.md lag bis
# zum 01.09.2026 offen unter / — im Repository ist das gewollt, auf dem
# Webspace nicht. Der Deploy laedt sie ab sofort nicht mehr hoch; diese
# Sperre gilt fuer die Kopie, die schon dort liegt.
<FilesMatch "\.(md|markdown)$">
  Require all denied
</FilesMatch>

# Die Abrisskiste und alles, was nach Werkstattrest aussieht.
#
# _to_delete/ steht seit cc760e5 in der .gitignore — aber die beiden Dateien
# darin waren zu dem Zeitpunkt schon getrackt, und eine Ignorierregel greift
# fuer bereits getrackte Dateien nicht. Sie wurden deshalb weiter versioniert
# und bei jedem Deploy mitgeliefert. Am 12.09.2026 nachgemessen: beide waren
# unter /_to_delete/ oeffentlich lesbar und wurden als Klartext ausgeliefert,
# weil .patch und .alt kein PHP sind und Apache sie nicht ausfuehrt.
# werkstatt.patch war der komplette Werkstatt-Umbau als Diff,
# integrationen.php.alt der Quelltext der Verwaltungsseite. Keine Zugangsdaten
# darin (nur Platzhalter wie sk_test_…), aber die Bauart der Verwaltung samt
# Tat-Namen und Formularfeldern — genau das, womit ein Angriff anfaengt.
#
# Zwei Regeln, weil eine allein zu wenig faengt: Die Endungen halten jede
# weitere Datei dieser Art auf, auch eine, die morgen irgendwo anders liegt;
# der Ordner haelt alles auf, was kuenftig darin landet. Aus dem Repository
# sind die Dateien seit dem 12.09.2026 raus, vom Webspace muessen sie von
# Hand weg — der Deploy loescht nie.
#
# Mit einem echten Apache 2.4.58 gemessen, nicht mit "php -S":
# /_to_delete/werkstatt.patch 403, /_to_delete/integrationen.php.alt 403,
# /_to_delete/ 404, /tmpprobe/x.bak 403 (Gegenprobe ausserhalb des Ordners),
# /index.html 200 und /e/ANNA3CU 200 — die bestehenden Regeln bleiben heil.
# Dass die beiden Dateien 403 und nicht 404 melden, ist die bekannte Falle:
# <FilesMatch> wird nach allem davor angewandt und gewinnt gegen die
# RewriteRule. Gewollt ist beides — zu sein hat die Datei nichts.
<FilesMatch "\.(alt|bak|orig|patch|diff|save|swp|sql|log)$">
  Require all denied
</FilesMatch>
RewriteRule ^_to_delete/ - [R=404,L]

# --------------------------------------------------------------------------
# Zwischenspeicher im Browser.
#
# Der Webspace schickt von sich aus kein Cache-Control. Dann raet der Browser
# — und ein wiederkehrender Besucher kann stundenlang eine alte Datei
# weiterbenutzen. Bei einer kaputten qform.js hiesse das: weiter verlorene
# Anfragen, obwohl die Reparatur laengst oben liegt.
#
# Deshalb: HTML immer nachfragen, Bilder und Schriften lange behalten. Die
# eigenen CSS- und JS-Dateien tragen seit dem 01.09.2026 einen
# Fingerabdruck in der Adresse (build.mjs) — aendert sich der Inhalt,
# aendert sich die Adresse. Sie duerfen deshalb kurz gehalten und muessen
# nur nachgeprueft werden.
#
# In IfModule gekapselt: Fehlt das Modul auf dem Tarif, wird der Block
# uebersprungen, statt die ganze Seite mit einem 500 lahmzulegen.
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header set Cache-Control "public, max-age=31536000, immutable" env=FESTGENAGELT
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|woff2|woff|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
    Header set Cache-Control "public, max-age=31536000, immutable" env=FESTGENAGELT
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# Ein Fingerabdruck in der Adresse heisst: diese Datei aendert sich nie mehr.
#
# Die Regel darueber gibt CSS und JS eine Stunde. Das war richtig, solange
# eine Adresse zweierlei Inhalt haben konnte — bei einer kaputten qform.js
# haette ein Besucher sonst stundenlang die kaputte Fassung behalten.
#
# Seit build.mjs an jede eigene CSS-, JS-, Bild- und Videoadresse einen
# Fingerabdruck aus dem Inhalt haengt, gilt das nicht mehr: Aendert sich der
# Inhalt, aendert sich die Adresse. Die alte Datei wird dann nie wieder
# angefragt, und die neue kommt sofort an. Sie ein Jahr behalten zu duerfen
# ist damit nicht mutig, sondern richtig.
#
# Gemessen am 05.09.2026: Die Startseite laedt neunzehn CSS- und
# JS-Adressen. Mit einer Stunde fragt ein Rueckkehrer sie alle neu an.
#
# WARUM ES AN DER ADRESSE HAENGT UND NICHT AN DER ENDUNG
# Nicht alles traegt einen Fingerabdruck. Die Module unter assets/js/world/
# laden einander ueber ihre eigenen import-Zeilen, da steht kein ?v= dahinter
# — und genau an diesen Dateien wird am meisten geaendert. Sie behalten die
# eine Stunde. Ein Jahr auf einer Adresse ohne Fingerabdruck waere ein Jahr
# ohne Rueckweg.
#
# Beides in IfModule: Fehlt ein Modul auf dem Tarif, wird der Block
# uebersprungen, statt die Seite mit einem 500 lahmzulegen.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteCond %{QUERY_STRING} (^|&)v=[A-Za-z0-9]+($|&)
  RewriteRule \.(css|js|webp|avif|jpg|jpeg|png|svg|woff2|woff|mp4|webm)$ - [E=FESTGENAGELT:1]
</IfModule>
# WARUM DIE ZEILE IM SELBEN FILESMATCH STEHT UND NICHT DANEBEN
# Erster Versuch war ein eigener Header-Block hinter den anderen. Gemessen:
# Er blieb wirkungslos. Apache wendet alles in einem <FilesMatch> NACH dem
# an, was ausserhalb steht — egal, was weiter unten in der Datei steht. Die
# Stundenregel hat die Jahresregel also jedes Mal ueberschrieben. Deshalb
# stehen jetzt beide im selben Block: erst die kurze, dann die lange, und
# die lange gilt nur, wenn die Weiche oben sie eingeschaltet hat.

# Eigene Fehlerseite statt der Standardmeldung des Servers
ErrorDocument 404 /404.html

# Immer über https ausliefern
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Die Zähldatei ist nicht für Besucher bestimmt
<Files "besuche.csv">
  Require all denied
</Files>
<Files "config.local.php">
  Require all denied
</Files>
# Arbeitsnotizen gehoeren nicht auf die Kundendomain. PROJEKT.md lag bis
# zum 01.09.2026 offen unter / — im Repository ist das gewollt, auf dem
# Webspace nicht. Der Deploy laedt sie ab sofort nicht mehr hoch; diese
# Sperre gilt fuer die Kopie, die schon dort liegt.
<FilesMatch "\.(md|markdown)$">
  Require all denied
</FilesMatch>

.DS_Store
Thumbs.db
caps/
video/*.webm
config.local.php
besuche.csv
app/config.local.php
app/uploads/

# Der Passwortschutz des Cockpits entsteht auf dem Server und gehoert
# nicht ins Repository — sonst laege die Pruefsumme oeffentlich einsehbar.
cockpit/.htaccess
cockpit/.htpasswd

# Datenbankauszuege und die Notfallablage des Formulars entstehen auf dem
# Server und enthalten Kundendaten. Das Repository ist oeffentlich — sie
# duerfen dort unter keinen Umstaenden landen.
app/sicherungen/
app/notfall/

# Eingangsbelege und die fertigen Jahrespakete fuers Finanzamt. Beides
# entsteht auf dem Server, beides enthaelt Rechnungen mit Namen und
# Betraegen — und das Repository ist oeffentlich.
app/eingang/
app/steuerakte/

# Zwischenschritte der Videoaufnahme. Die fertigen .mp4 gehoeren ins
# Repository, die rohen .webm und der Ordner, in den Playwright sie legt,
# nicht — sie sind dreimal so gross und entstehen jederzeit neu.
video/roh/
video/*.webm

# Ausnahme: video/auftakt.webm ist keine Rohaufnahme, sondern die kleine
# Fassung des Auftakts, die die Seite als erste Quelle anbietet. Sie muss
# ins Repository, weil der Deploy nur hochlaedt, was dort liegt.
!video/auftakt.webm
node_modules/

# Die einzelnen Sprachaufnahmen. Sie stecken fertig im Video; einzeln braucht
# sie nur, wer den Ton neu mischen will — und dann liegen sie hier lokal.
video/ton/

# Zwischenspeicher (RDAP-Serverliste). Entsteht zur Laufzeit, gehoert nicht ins Repository.
app/zwischenspeicher/

# Die Ablage fuer Dateien, die weg sollen. In den verbundenen Ordnern darf
# Claude nichts loeschen -- was wegsoll, wandert deshalb hierher und wird von
# Uwe geloescht. Ein "git add -A" hat diesen Ordner schon einmal mitgenommen;
# seitdem steht er hier.
_to_delete/

# Gespeicherte Seitenansichten der Verwaltung. Wer eine Ansicht zum Ansehen
# beiseitelegt, nennt sie "_name.html" -- und genau so lagen _baukasten.html
# und _baukasten_ende.html seit dem 08.09.2026 im Repository und damit
# oeffentlich auf dem Webspace: gerendertes /app/baukasten mit Menue,
# Arbeitszahlen, Tat-Namen und der internen Preistabelle. Der Unterstrich
# gilt deshalb ab jetzt als Merkmal: Wurzeldateien mit ihm bleiben draussen.
# Nur in der Wurzel -- richtungen/_rahmen.css ist ein echtes Stilblatt und
# wird gebraucht.
/_*.html

# Die 3D-Werkstatt. Blender-Dateien, Renderings und Texturen — zusammen
# ueber 50 MB, und nichts davon gehoert auf den Webspace. Was die Website
# wirklich braucht, liegt fertig unter assets/3d/ und assets/img/3d/.
#
# Steht hier, seit der Ordner am 13.09.2026 neben dem Klon im selben
# Verzeichnis liegt: Ein "git add -A" haette ihn sonst mitgenommen.
3d-produktion/

# Ausnahme: die Skripte selbst. Sie sind ein paar Kilobyte gross und tragen
# das Wissen, das die Blender-Datei nicht traegt — warum der Saal ein Keil
# ist, warum die Webfassung andere Zahlen braucht als Cycles. Am 14.09.2026
# aufgenommen, nachdem bauabnahme.py um ein Haar nur auf einem Rechner
# existiert haette. Die .blend-Dateien, Renderings und Texturen bleiben
# draussen — die sind der Grund fuer die Regel darueber.
!3d-produktion/
!3d-produktion/*.py

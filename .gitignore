.DS_Store
Thumbs.db
caps/
video/*.webm
config.local.php
besuche.csv
app/config.local.php
app/uploads/

# Der Passwortschutz des Cockpits entsteht auf dem Server und gehoert
# nicht ins Repository — sonst laege die Pruefsumme oeffentlich einsehbar.
cockpit/.htaccess
cockpit/.htpasswd

# Datenbankauszuege und die Notfallablage des Formulars entstehen auf dem
# Server und enthalten Kundendaten. Das Repository ist oeffentlich — sie
# duerfen dort unter keinen Umstaenden landen.
app/sicherungen/
app/notfall/

# Eingangsbelege und die fertigen Jahrespakete fuers Finanzamt. Beides
# entsteht auf dem Server, beides enthaelt Rechnungen mit Namen und
# Betraegen — und das Repository ist oeffentlich.
app/eingang/
app/steuerakte/

# Zwischenschritte der Videoaufnahme. Die fertigen .mp4 gehoeren ins
# Repository, die rohen .webm und der Ordner, in den Playwright sie legt,
# nicht — sie sind dreimal so gross und entstehen jederzeit neu.
video/roh/
video/*.webm

# Ausnahme: video/auftakt.webm ist keine Rohaufnahme, sondern die kleine
# Fassung des Auftakts, die die Seite als erste Quelle anbietet. Sie muss
# ins Repository, weil der Deploy nur hochlaedt, was dort liegt.
!video/auftakt.webm
node_modules/

# Die einzelnen Sprachaufnahmen. Sie stecken fertig im Video; einzeln braucht
# sie nur, wer den Ton neu mischen will — und dann liegen sie hier lokal.
video/ton/

# Zwischenspeicher (RDAP-Serverliste). Entsteht zur Laufzeit, gehoert nicht ins Repository.
app/zwischenspeicher/

@@ -490,6 +519,16 @@
       <div class="feld"><label>Adresse des Entwurfs</label>
         <input name="preview_url" placeholder="https://vorschau.vecom-design.it/…"
                value="<?= Fmt::h($vsUrl) ?>"></div>
+      <?php /* Wo der Quelltext liegt, ist in Monat 14 die eigentliche Frage:

# Kopie als .env anlegen und ausfuellen. Die .env kommt nie ins Repository.

# Die Tuer zur Verwaltung. Schluessel: Verwaltung → Neue Kunden finden →
# Compliance & Versand → Worker-Schluessel erzeugen.
AKQUISE_URL=https://vecom-design.it/akquise.php
AKQUISE_SCHLUESSEL=

# Claude fuer Deutung und Texte. Leer = keine KI, nur maschinelle Pruefung.
ANTHROPIC_API_KEY=
AKQUISE_CLAUDE_MODELL=claude-sonnet-5
# Obergrenze je Lauf (Eingabe + Ausgabe). Danach stoppt die KI fuer diesen Lauf.
AKQUISE_KI_MAX_TOKEN=250000

# Optional: Google PageSpeed Insights (Felddaten, Lighthouse aus Googles Netz).
# Leer = Lighthouse laeuft lokal auf diesem Rechner.
AKQUISE_PSI_SCHLUESSEL=

# Mengen je Lauf — Qualitaet vor Quantitaet.
AKQUISE_AUDITS_PRO_LAUF=20
AKQUISE_TEXTE_PRO_LAUF=5
AKQUISE_SCORE_MIN_TEXT=51

# OpenStreetMap-Abfragen (Overpass). Bitte fair bleiben: Pause zwischen Abfragen.
AKQUISE_OVERPASS=https://overpass-api.de/api/interpreter
AKQUISE_OVERPASS_PAUSE_S=12

# 1 = nichts an die Verwaltung melden, nur anzeigen (zum Ausprobieren).
AKQUISE_TROCKEN=0
